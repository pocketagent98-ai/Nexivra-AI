# VeriForge AI — environment template
# Copy to .env and fill in. NEVER commit a real key.

# Fernet master key for the encrypted provider vault.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=

# NOTE: provider API keys (NVIDIA_API_KEY, ZAI_API_KEY) are NOT read from
# the environment by the vault. They are entered through the official
# connect flow and stored encrypted. See docs/NVIDIA-NIM.md.
