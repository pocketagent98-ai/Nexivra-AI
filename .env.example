# Nexivra AI — environment template
# Copy to .env and fill in. NEVER commit a real key.

# Fernet master key for the encrypted provider vault.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=

# Local AI (offline / low-connectivity mode). GGUF files are NOT committed
# to the repository — download from the official sources and verify the
# license and hash of the exact build you ship.
NEXIVRA_LOCAL_MODEL=models/qwen3-0.6b-q4_0.gguf
# Optional emergency ultra-lite (English-centric, optional only):
# NEXIVRA_LOCAL_ULTRA_LITE=models/smollm2-135m-instruct-q4_0.gguf

# Device profile: lite | balanced | auto  (see docs/MOBILE.md)
NEXIVRA_DEVICE_PROFILE=auto

# NOTE: provider API keys (NVIDIA_API_KEY, ZAI_API_KEY) are NOT read from
# the environment by the vault. They are entered through the official
# connect flow and stored encrypted. See docs/NVIDIA-NIM.md.
